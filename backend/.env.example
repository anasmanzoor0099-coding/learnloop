# MongoDB Atlas connection string (or a local MongoDB instance)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/learnloop?retryWrites=true&w=majority

# A long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional. Defaults to 3000 locally.
PORT=3000
