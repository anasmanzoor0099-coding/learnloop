# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/learnloop?retryWrites=true&w=majority

# A long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# A private code required to unlock the instructor Studio.
# Change this before deploying. Do not reuse your instructor password.
INSTRUCTOR_ACCESS_CODE=replace-with-a-private-studio-code

# Optional. Defaults to 3000 locally.
PORT=3000
